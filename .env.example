# Set to "true" only during local development
FLASK_DEBUG=false

# Directory where registered face images are stored
KNOWN_FACES_DIR=known_faces

# Path to the attendance CSV file
ATTENDANCE_FILE=Attendance.csv

# Path to your Google Cloud service account JSON key
GOOGLE_APPLICATION_CREDENTIALS=keys/service_account.json

# Supabase credentials (get from Project Settings → API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here